/* =========================================================
   SPICe Lab - Ciencia Aplicada al Campo
   Estilos específicos de esta página
========================================================= */

main {
  max-width: none;
  margin: 0;
  padding: 0;
}

/* HERO */
.campo-hero {
  background: radial-gradient(circle at 50% 0%, #f5f5f7 0%, #ffffff 70%);
  padding: 78px 7% 72px;
  border-bottom: 1px solid rgba(0,0,0,0.05);
  text-align: center;
}

.campo-hero-content {
  max-width: 980px;
  margin: 0 auto;
}

.campo-badge {
  display: inline-block;
  background: #e1f0ff;
  color: var(--primary);
  padding: 6px 12px;
  border-radius: 99px;
  font-size: 0.85rem;
  font-weight: 700;
  margin-bottom: 18px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.campo-badge-inline {
  margin-bottom: 14px;
}

.campo-badge-dark {
  background: rgba(255,255,255,0.14);
  color: #ffffff;
}

.campo-hero h1 {
  font-size: clamp(2.6rem, 5vw, 4.2rem);
  margin: 0 0 22px;
  color: var(--text-main);
  letter-spacing: -0.02em;
}

.campo-subtitle {
  font-size: 1.22rem;
  color: var(--primary);
  margin: 0 auto 22px;
  font-weight: 600;
  line-height: 1.5;
  max-width: 860px;
}

.campo-intro {
  font-size: 1.08rem;
  color: var(--text-secondary);
  line-height: 1.75;
  margin: 0 auto 14px;
  max-width: 860px;
}

.campo-hero-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
  margin-top: 32px;
}

/* BOTONES */
.campo-primary {
  background: var(--primary);
  color: #fff;
}

.campo-secondary {
  background: #ffffff;
  color: var(--text-main);
  border: 1px solid rgba(0,0,0,0.08);
}

.campo-secondary-dark {
  background: rgba(255,255,255,0.08);
  color: #ffffff;
  border: 1px solid rgba(255,255,255,0.18);
}

.campo-secondary-dark:hover {
  background: rgba(255,255,255,0.14);
}

/* LAYOUT */
.campo-section {
  padding: 76px 7%;
}

.campo-alt {
  background: var(--bg-light);
}

.campo-wrapper {
  max-width: 1180px;
  margin: 0 auto;
}

.campo-narrow {
  max-width: 900px;
}

.campo-section-title {
  margin: 0 0 18px;
  font-size: clamp(2rem, 4vw, 3rem);
  color: var(--text-main);
  text-align: center;
  letter-spacing: -0.01em;
}

.campo-section-intro {
  margin: 0 auto 54px;
  font-size: 1.08rem;
  color: var(--text-secondary);
  text-align: center;
  max-width: 820px;
  line-height: 1.7;
}

/* PROGRAM CARDS */
.campo-program-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px;
}

.campo-program-card {
  background: var(--white);
  border-radius: 28px;
  padding: 34px;
  border: 1px solid rgba(0,0,0,0.05);
  box-shadow: 0 4px 18px rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
}

.campo-program-card.featured {
  border: 1px solid rgba(0, 113, 227, 0.16);
  box-shadow: 0 10px 30px rgba(0, 113, 227, 0.08);
}

.campo-program-head h3 {
  margin: 0 0 10px;
  font-size: 1.9rem;
  color: var(--text-main);
}

.campo-card-subtitle {
  margin: 0 0 20px;
  color: var(--primary);
  font-weight: 600;
  line-height: 1.5;
}

.campo-program-card p {
  color: var(--text-secondary);
  line-height: 1.72;
  margin: 0 0 14px;
  font-size: 1rem;
}

.campo-pill {
  display: inline-block;
  background: #eef6ff;
  color: var(--primary);
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: 14px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.campo-pill-dark {
  background: #f2f2f4;
  color: var(--text-main);
}

.campo-list-block {
  margin-top: 18px;
  padding-top: 18px;
  border-top: 1px solid rgba(0,0,0,0.06);
}

.campo-list-block h4 {
  margin: 0 0 12px;
  color: var(--text-main);
  font-size: 1.02rem;
}

.campo-list-block ul {
  margin: 0;
  padding-left: 20px;
}

.campo-list-block li {
  color: var(--text-secondary);
  font-size: 0.98rem;
  line-height: 1.7;
  margin-bottom: 8px;
}

/* PRICE BOX */
.campo-price-box {
  margin-top: 26px;
  padding: 20px 22px;
  border-radius: 20px;
  background: linear-gradient(180deg, #f7fbff 0%, #eef6ff 100%);
  border: 1px solid rgba(0, 113, 227, 0.1);
}

.campo-price-box-simple {
  background: linear-gradient(180deg, #f8f8f9 0%, #f2f2f4 100%);
  border: 1px solid rgba(0,0,0,0.06);
}

.campo-price-current {
  font-size: 1.08rem;
  color: var(--text-main);
  line-height: 1.5;
}

.campo-price-current strong {
  display: inline-block;
  font-size: 1.9rem;
  color: var(--text-main);
  letter-spacing: -0.02em;
  margin-left: 6px;
}

.campo-price-old {
  margin-top: 8px;
  color: var(--text-secondary);
  text-decoration: line-through;
  font-size: 1rem;
}

.campo-card-actions {
  margin-top: 28px;
}

/* IMPORTANT BOX */
.campo-note-box {
  background: var(--white);
  border-radius: 28px;
  padding: 42px;
  box-shadow: var(--shadow);
  border-left: 6px solid var(--primary);
  text-align: center;
}

.campo-note-box h2 {
  margin: 0 0 18px;
  color: var(--text-main);
  font-size: clamp(1.8rem, 4vw, 2.6rem);
}

.campo-note-box p {
  margin: 0 0 14px;
  color: var(--text-secondary);
  line-height: 1.75;
  font-size: 1.05rem;
}

/* COMPARISON */
.campo-compare-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
  margin-top: 18px;
}

.campo-compare-card {
  background: var(--white);
  border-radius: 24px;
  padding: 30px;
  border: 1px solid rgba(0,0,0,0.05);
  box-shadow: 0 3px 12px rgba(0,0,0,0.03);
  text-align: center;
}

.campo-compare-card h3 {
  margin: 0 0 12px;
  color: var(--text-main);
  font-size: 1.3rem;
}

.campo-compare-card p {
  margin: 0;
  color: var(--text-secondary);
  line-height: 1.7;
}

/* CTA */
.campo-cta {
  background: #000000;
  padding: 78px 7%;
}

.campo-cta h2 {
  color: #ffffff;
  margin: 0 0 18px;
  font-size: clamp(2rem, 4vw, 3rem);
  text-align: center;
}

.campo-cta p {
  color: rgba(255,255,255,0.82);
  text-align: center;
  max-width: 760px;
  margin: 0 auto;
  line-height: 1.75;
  font-size: 1.05rem;
}

.campo-center-actions {
  margin-top: 28px;
}

/* HELPERS */
.text-center {
  text-align: center;
}

/* HOVER */
.campo-program-card:hover,
.campo-compare-card:hover {
  transform: translateY(-4px);
  transition: var(--transition);
  box-shadow: var(--shadow-lg);
}

/* RESPONSIVE */
@media (max-width: 1024px) {
  .campo-program-grid,
  .campo-compare-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .campo-hero,
  .campo-section,
  .campo-cta {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .campo-program-card,
  .campo-note-box,
  .campo-compare-card {
    padding: 24px;
  }

  .campo-hero-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .campo-hero-actions .button {
    width: 100%;
    text-align: center;
  }

  .campo-price-current strong {
    display: block;
    margin-left: 0;
    margin-top: 6px;
  }
}
